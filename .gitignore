# Browser profiles hold live session cookies for real shopping accounts.
# Committing these would leak account access.
.profiles/

# Run artifacts: screenshots may contain addresses, phone numbers and order data.
runs/

# Result workbooks are tracked deliberately: they are the assignment's
# write-back deliverable. Uploads are only duplicates of the source sheet, and
# --sample output is regenerable at any time by re-running the sample.
data/uploads/
data/sample-run-results.xlsx

# Output of a discovery run, named for the moment it ran. Contains real order
# ids and refund amounts from whoever's account was signed in.
returns-*.xlsx

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
